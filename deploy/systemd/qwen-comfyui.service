[Unit]
Description=ComfyUI for the Qwen UI pipeline
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/qwen-image-pipeline/ComfyUI
ExecStart=%h/.local/share/qwen-image-pipeline/run-comfyui.sh
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
