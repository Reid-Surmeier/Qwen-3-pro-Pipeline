{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reidsurmeier.wtf/schemas/qwen-ui-edit-brief.schema.json",
  "title": "Qwen UI Edit Brief",
  "type": "object",
  "required": ["objective", "reference_role", "preservation_invariants", "output"],
  "properties": {
    "provider": {
      "enum": ["auto", "openrouter", "alibaba"]
    },
    "model": {
      "enum": ["qwen/qwen-image-3-pro", "qwen/qwen-image-3"]
    },
    "objective": {"type": "string", "minLength": 1},
    "reference_role": {"type": "string", "minLength": 1},
    "preservation_invariants": {
      "type": "array",
      "items": {"type": "string"}
    },
    "canvas": {
      "type": "array",
      "items": {"type": "string"}
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "change"],
        "properties": {
          "name": {"type": "string"},
          "change": {"type": "string"},
          "preserve": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "exact_copy": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["region", "text"],
        "properties": {
          "region": {"type": "string"},
          "text": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "style": {"type": "array", "items": {"type": "string"}},
    "asset_rules": {"type": "array", "items": {"type": "string"}},
    "negative_constraints": {"type": "array", "items": {"type": "string"}},
    "quality_checks": {"type": "array", "items": {"type": "string"}},
    "output": {
      "type": "object",
      "required": ["resolution", "aspect_ratio", "count"],
      "properties": {
        "resolution": {"enum": ["1K", "2K"]},
        "aspect_ratio": {
          "enum": ["source", "1:1", "1:2", "1:4", "2:1", "2:3", "3:2", "3:4", "4:1", "4:3", "4:5", "5:4", "9:16", "16:9"]
        },
        "size": {"type": "string", "pattern": "^[1-9][0-9]*\\*[1-9][0-9]*$"},
        "count": {"type": "integer", "minimum": 1, "maximum": 6},
        "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
